#!/usr/bin/env bash
# Spell-check staged .md/.html; optimize staged images before committing.
# One-time setup: git config core.hooksPath hooks

set -euo pipefail

STAGED_TEXT=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(md|html)$' || true)
STAGED_IMAGES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^src/static/images/.+\.(jpe?g|png|webp)$' || true)

if [ -n "$STAGED_TEXT" ]; then
  echo "Running cspell on staged files..."
  echo "$STAGED_TEXT" | tr '\n' '\0' | xargs -0 bunx cspell --no-progress --no-summary
fi

if [ -n "$STAGED_IMAGES" ]; then
  echo "Optimizing staged images..."
  bun run scripts/optimize-images.ts -- $(echo "$STAGED_IMAGES" | tr '\n' ' ')
  echo "$STAGED_IMAGES" | tr '\n' '\0' | xargs -0 git add
fi